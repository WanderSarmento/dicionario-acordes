rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'wander.sarmentosantos@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidStudentRanking(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'avatarEmoji',
        'correctCount',
        'totalHits',
        'attemptsCount',
        'accuracy',
        'bestStreak',
        'completedIds',
        'isPublic',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'uid',
        'displayName',
        'avatarEmoji',
        'correctCount',
        'totalHits',
        'attemptsCount',
        'accuracy',
        'bestStreak',
        'completedIds',
        'isPublic',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.uid)
      && data.uid == userId
      && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40
      && data.avatarEmoji is string && data.avatarEmoji.size() >= 1 && data.avatarEmoji.size() <= 12
      && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 20
      && data.totalHits is int && data.totalHits >= 0 && data.totalHits <= 10000
      && data.attemptsCount is int && data.attemptsCount >= 0 && data.attemptsCount <= 10000
      && data.accuracy is int && data.accuracy >= 0 && data.accuracy <= 100
      && data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 1000
      && data.completedIds is list && data.completedIds.size() <= 20
      && (data.completedIds.size() == 0 || data.completedIds[0] is int)
      && data.isPublic is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /rankings/{userId} {
      allow get: if isValidId(userId) && (
        isOwner(userId) ||
        isAdmin() ||
        (resource != null && existing().isPublic == true && existing().correctCount >= 0)
      );

      allow list: if existing().correctCount >= 0;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidStudentRanking(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidStudentRanking(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'avatarEmoji',
          'correctCount',
          'totalHits',
          'attemptsCount',
          'accuracy',
          'bestStreak',
          'completedIds',
          'isPublic',
          'updatedAt'
        ]);

      allow delete: if isVerified()
        && isValidId(userId)
        && (isOwner(userId) || isAdmin());
    }

    match /admins/{adminId} {
      allow get: if isVerified() && isValidId(adminId) && isOwner(adminId);
      allow list, create, update, delete: if false;
    }
  }
}
